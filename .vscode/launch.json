{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Krunix · QEMU (LLDB)",
            "type": "lldb-dap",
            "request": "launch",
            "program": "${workspaceFolder}/target/riscv64gc-unknown-none-elf/debug/krunix",
            "cwd": "${workspaceFolder}",
            "stopOnEntry": true,
            "preLaunchTask": "Krunix: start QEMU",
            "launchCommands": [
                "!gdb-remote 127.0.0.1:1234",
                "!target modules load --file krunix --slide 0"
            ]
        }
    ]
}
